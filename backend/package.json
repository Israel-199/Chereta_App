{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:chereta": "ts-node scripts/seedChereta.ts",
    "db:migrate": "node scripts/runWithDirectUrl.js npx prisma migrate deploy",
    "db:repair-chereta": "node scripts/runWithDirectUrl.js npx ts-node scripts/repairCheretaSchema.ts",
    "db:setup-chereta": "npm run db:repair-chereta && npx prisma db seed && npm run seed:chereta",
    "db:setup": "npm run db:setup-chereta"
  },
  "prisma": {
    "schema": "src/utils/prisma/schema.prisma",
    "seed": "ts-node src/utils/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "prisma": "^5.22.0",
    "request-ip": "^3.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.0",
    "@types/request-ip": "^0.0.41",
    "install": "^0.13.0",
    "nodemon": "^3.1.11",
    "npm": "^11.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
