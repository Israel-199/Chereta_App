generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  phoneNumber      String?           @unique
  status           UserStatus        @default(ACTIVE)
  suspensionReason String?
  verifiedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  address          String?
  firstName        String?
  gender           String?
  lastName         String?
  level            Int               @default(1)
  photo            String?
  role             Role              @default(MEMBER)
  passwordHash     String?
  email            String?           @unique
  username         String?           @unique
  activities       ActivityLog[]
  adminActions     AdminActionLog[]  @relation("AdminActions")
  AuditLog         AuditLog[]
  devices          Device[]
  lotteryWins      LotteryRound[]    @relation("LotteryWinner")
  lotterySpins     LotterySpin[]
  notifications    NotificationLog[]
  otpLogs          OtpLog[]
  RefreshToken     RefreshToken[]
  attachments      Attachment[]      @relation("UserAttachments")
  supportTickets   SupportTicket[]
  idStatus         IdStatus          @default(NONE)
  idType           String?
  idNumber         String?
  userCode         String?           @unique

  bids              Bid[]
  servicePayments   CheretaServicePayment[]
  termsAcceptances  AuctionTermsAcceptance[]
}

enum IdStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

model SupportTicket {
  id        String       @id @default(uuid())
  userId    String
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AttachmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Attachment {
  id        String           @id @default(uuid())
  userId    String
  fileUrl   String
  fileName  String?
  fileType  String?
  publicId  String?
  about     String?
  status    AttachmentStatus @default(PENDING)
  createdAt DateTime         @default(now())
  user      User             @relation("UserAttachments", fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id           String    @id @default(uuid())
  userId       String
  deviceId     String
  lastLoginAt  DateTime?
  lastLogoutAt DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
}

model OtpLog {
  id          String    @id @default(uuid())
  userId      String
  phoneNumber String
  code        String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  verifiedAt  DateTime?
  attempts    Int       @default(0)
  ipAddress   String?
  user        User      @relation(fields: [userId], references: [id])

  @@index([phoneNumber])
}

model AppConfig {
  id         String    @id @default(uuid())
  appLive    Boolean   @default(false)
  launchDate DateTime?
  updatedAt  DateTime  @updatedAt
}

model NotificationLog {
  id                String              @id @default(uuid())
  userId            String
  type              NotificationType
  channel           NotificationChannel
  status            NotificationStatus
  title             String?
  message           String?
  providerMessageId String?
  createdAt         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookLog {
  id           String          @id @default(uuid())
  provider     PaymentProvider
  payload      Json
  failedReason String?
  createdAt    DateTime        @default(now())
}

model AdminActionLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String
  targetId  String?
  reason    String?
  createdAt DateTime @default(now())
  admin     User     @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)
}

model LotteryRound {
  id        String        @id @default(uuid())
  date      DateTime      @unique
  isActive  Boolean       @default(true)
  winnerId  String?
  reward    String?
  createdAt DateTime      @default(now())
  winner    User?         @relation("LotteryWinner", fields: [winnerId], references: [id])
  spins     LotterySpin[]
}

model LotterySpin {
  id      String       @id @default(uuid())
  userId  String
  roundId String
  spunAt  DateTime     @default(now())
  result  String?
  round   LotteryRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roundId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String?
  ipAddress String?
  action    String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action])
}

// ----- CHERETA (AUCTION) SPECIFIC MODELS -----

model AuctionItem {
  id            String          @id @default(uuid())
  auctionCode   String          @unique
  title         String
  category      AuctionCategory
  categoryLabel String?
  itemNumber    String?
  specs         Json?
  images        String[]
  serviceFee    Float           @default(75)
  minBid        Float           @default(1.01)
  maxBid        Float           @default(999.99)
  bidStep       Float           @default(0.01)
  viewCount     Int             @default(0)
  startTime     DateTime
  endTime       DateTime
  status        AuctionStatus   @default(ACTIVE)
  winnerUserId  String?
  winningAmount Float?
  resolvedAt    DateTime?
  twoHourAlertSent Boolean @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  bids            Bid[]
  servicePayments CheretaServicePayment[]
  termsAcceptances AuctionTermsAcceptance[]
}

model AuctionTermsAcceptance {
  id            String      @id @default(uuid())
  userId        String
  auctionItemId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  auctionItem   AuctionItem @relation(fields: [auctionItemId], references: [id], onDelete: Cascade)

  @@unique([userId, auctionItemId])
  @@index([auctionItemId])
}

model Bid {
  id               String                 @id @default(uuid())
  userId           String
  auctionItemId    String
  amount           Float
  servicePaymentId String?                @unique
  createdAt        DateTime               @default(now())
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  auctionItem      AuctionItem            @relation(fields: [auctionItemId], references: [id], onDelete: Cascade)
  servicePayment   CheretaServicePayment? @relation(fields: [servicePaymentId], references: [id])

  @@index([auctionItemId, amount])
}

model CheretaServicePayment {
  id            String               @id @default(uuid())
  userId        String
  auctionItemId String
  bidAmount     Float
  amount        Float
  currency      String               @default("ETB")
  status        CheretaPaymentStatus @default(PENDING)
  provider      String               @default("CHAPA")
  txRef         String               @unique
  chapaRef      String?
  checkoutUrl   String?
  createdAt     DateTime             @default(now())
  paidAt        DateTime?
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  auctionItem   AuctionItem          @relation(fields: [auctionItemId], references: [id], onDelete: Cascade)
  bid           Bid?

  @@index([userId, auctionItemId, status])
}

enum CheretaPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum AuctionCategory {
  DIGITAL
  APPLIANCE
}

enum AuctionStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum Role {
  ADMIN
  SUPER_ADMIN
  FINANCE_ADMIN
  CUSTOMER_SERVICE_ADMIN
  MEMBER
}

enum PaymentProvider {
  TELEBIRR
  CHAPA
  CBE
  DASHEN
  COOP
  AMHARA
  AWASH
  ABYISINIA
  SAFARICOM
  MASTERCARD
}

enum NotificationType {
  OTP
  REMINDER
  PAYMENT_SUCCESS
  PAYOUT_CONFIRMED
  BID_PLACED
  AUCTION_WON
  AUCTION_2H
  AUCTION_ENDED
}

enum NotificationChannel {
  SMS
  IN_APP
}

enum NotificationStatus {
  SENT
  FAILED
}
