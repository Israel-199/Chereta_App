{
  "expo": {
    "name": "Digital Chereta",
    "slug": "digital-chereta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "digitalchereta",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/fonts/*"
    ],
    "updates": {
      "fallbackToCacheTimeout": 3000
    },
    "android": {
      "package": "com.isru.digitalchereta",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.isru.digitalchereta",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "separateBuildByAbis": true,
            "extraProguardRules": "-keep class com.facebook.hermes.unicode.** { *; }"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "borderColor": "#000000",
          "barStyle": "light"
        }
      ],
      "./plugins/android-nav-fix",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "884df8ac-6e71-41d2-a8dd-fe8c7b316444"
      },
      "expo-navigation-bar": {
        "backgroundColor": "#000000",
        "borderColor": "#000000",
        "barStyle": "light",
        "style": "light"
      }
    }
  }
}
