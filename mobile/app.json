{
  "expo": {
    "name": "Habesha Equb",
    "slug": "Habesha_Equb",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habeshaequb",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/fonts/*"
    ],
    "updates": {
      "fallbackToCacheTimeout": 3000
    },
    "android": {
      "package": "com.isru.HabeshaEqub",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.isru.HabeshaEqub",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "separateBuildByAbis": true,
            "extraProguardRules": "-keep class com.facebook.hermes.unicode.** { *; }"
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "visible",
          "backgroundColor": "#000000",
          "borderColor": "#000000"
        }
      ],
      "./plugins/android-nav-fix",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c4a4049f-c6f9-4f98-b8f5-7f35ff07a8cd"
      },
      "expo-navigation-bar": {
        "position": "absolute",
        "visibility": "visible",
        "backgroundColor": "#000000",
        "borderColor": "#000000"
      }
    }
  }
}
